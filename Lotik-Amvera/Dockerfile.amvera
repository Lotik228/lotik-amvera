FROM node:24-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3-pil \
    && rm -rf /var/lib/apt/lists/*
COPY Lotik-Amvera/package.json Lotik-Amvera/LICENSE.Grovvik.txt Lotik-Amvera/*.mjs ./
COPY Lotik-Amvera/lotik-market-image.py ./
COPY Lotik-Amvera/public/ ./public/
ENV NODE_ENV=production \
    LOTIK_CONTAINER=1 \
    LOTIK_EMBEDDED_PARSER=1 \
    PORT=3000 \
    DATA_DIR=/data \
    DEMO_DATA_DIR=/data/demo \
    SQLITE_JOURNAL_MODE=delete
EXPOSE 3000
CMD ["node", "server.mjs"]
