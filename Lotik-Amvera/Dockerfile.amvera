FROM node:24-slim
WORKDIR /app
COPY package.json LICENSE.Grovvik.txt *.mjs ./
COPY public ./public
ENV NODE_ENV=production \
    LOTIK_CONTAINER=1 \
    LOTIK_EMBEDDED_PARSER=1 \
    PORT=3000 \
    DATA_DIR=/data \
    DEMO_DATA_DIR=/data/demo \
    SQLITE_JOURNAL_MODE=delete
EXPOSE 3000
CMD ["node", "server.mjs"]
