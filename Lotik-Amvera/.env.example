MODE=production
PORT=3000
LOTIK_LOCAL_PORT=3000
# off или live (с согласованным доступом).
PARSER_MODE=off
AVITO_ACCESS_APPROVED=0
# Минимальный интервал между всеми запросами парсера вместе.
PARSER_MIN_GAP_SECONDS=30
# Мини-приложение принимает только подписанные данные Telegram.
BOT_TOKEN=
TELEGRAM_TEST=0
WEBHOOK_SECRET=
PUBLIC_URL=
OWNER_TELEGRAM_ID=
SUPPORT_CONTACT=
# HTTPS-ссылка на конкретный пост Telegram с видеоинструкцией (необязательно).
TRACKING_HELP_VIDEO_URL=
# Веб-сайт открывается по адресу WEB_PUBLIC_URL/web/.
WEB_PUBLIC_URL=
CARD_PRICE_RUB=299
ENABLE_CARD_CHECKOUT=0
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST=1
PAYMENT_WEBHOOK_SECRET=
# Заполните, если чеки формируются по объекту receipt в запросе ЮKassa.
YOOKASSA_RECEIPT_VAT_CODE=
# HTTPS-адрес источника с согласованным доступом к объявлениям.
LISTINGS_FEED_URL=
LISTINGS_FEED_TOKEN=
FEED_INTERVAL_SECONDS=300
# Необязательно. Ключ API.SH для выдачи Авито внутри приложения.
AVITO_SEARCH_API_KEY=
# Ключ API.SH для фоновых проверок карточек. Заполняйте с учётом расхода кредитов.
AVITO_WATCH_API_KEY=
AVITO_API_DAILY_CREDITS=500
AVITO_API_MONTHLY_CREDITS=10000
# HTTPS-источник для актуальной проверки отдельной карточки по ID.
WATCH_LOOKUP_URL=
WATCH_LOOKUP_TOKEN=
DATA_DIR=./data
